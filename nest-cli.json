{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/restaurant-microservices-lab/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/restaurant-microservices-lab/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/restaurant-microservices-lab",
  "projects": {
    "cozinha-service": {
      "type": "application",
      "root": "apps/cozinha-service",
      "entryFile": "main",
      "sourceRoot": "apps/cozinha-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/cozinha-service/tsconfig.app.json"
      }
    },
    "restaurant-microservices-lab": {
      "type": "application",
      "root": "apps/restaurant-microservices-lab",
      "entryFile": "main",
      "sourceRoot": "apps/restaurant-microservices-lab/src",
      "compilerOptions": {
        "tsConfigPath": "apps/restaurant-microservices-lab/tsconfig.app.json"
      }
    }
  }
}